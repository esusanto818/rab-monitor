 session_start();
 header('Content-Type: application/json');

 $db = new crud();

+function requireAuthenticatedUser(): void
+{
+    if (!isset($_SESSION) || empty($_SESSION)) {
+        sendJsonResponse(false, [], 'Session tidak valid.');
+    }
+}
+
+function requireFormAccess(int $requiredLevel): void
+{
+    $currentLevel = (int)($_SESSION['FormAccess'] ?? 0);
+
+    if ($currentLevel < $requiredLevel) {
+        sendJsonResponse(
+            false,
+            [],
+            'Akses ditolak. Hak akses tidak mencukupi.'
+        );
+    }
+}
+
+function getCurrentUserId(): int
+{
+    return (int)(
+        $_SESSION['UserID']
+        ?? $_SESSION['user_id']
+        ?? $_SESSION['userid']
+        ?? 0
+    );
+}
